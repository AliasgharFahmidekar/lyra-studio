<Application x:Class="LyraStudio.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="WindowBrush" Color="#F4F6F8"/>
  <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SidebarBrush" Color="#171B24"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#7567E8"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#8992A3"/>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="13,8"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Background" Value="#7567E8"/>
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </Application.Resources>
</Application>
