<Window x:Class="LyraStudio.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 Title="Lyra Studio" Height="820" Width="1440" MinHeight="650" MinWidth="1100"
 WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E8EAF0" BorderThickness="0,0,0,1">
   <Grid Margin="20,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Border Width="34" Height="34" CornerRadius="10" Background="#7567E8" Margin="0,0,11,0">
      <TextBlock Text="L" Foreground="White" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <StackPanel VerticalAlignment="Center">
      <TextBlock Text="Lyra Studio" FontSize="16" FontWeight="Bold" Foreground="#202432"/>
      <TextBlock Text="WIDGET WORKSPACE" FontSize="9" Foreground="#8992A3"/>
     </StackPanel>
    </StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
     <Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="#25AA70" Margin="0,0,8,0"/>
     <TextBlock x:Name="ConnectionLabel" Text="Offline desktop" Foreground="#697386" VerticalAlignment="Center" Margin="0,0,12,0"/>
     <Button Content="Import Package" Background="#252B39" Click="ImportPackage_Click"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
    <DockPanel Margin="14">
     <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="WORKSPACE" Foreground="#788195" FontSize="10" FontWeight="Bold" Margin="9,12,0,12"/>
      <Button Content="  ◈   Widget Library" HorizontalContentAlignment="Left" Background="#2A2E3B" Margin="0,0,0,5" Click="Widgets_Click"/>
      <Button Content="  ▦   Recipe Studio" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#C4CAD5" Margin="0,0,0,5" Click="Recipes_Click"/>
      <TextBlock Text="LOCAL WORKSPACE" Foreground="#788195" FontSize="10" FontWeight="Bold" Margin="9,28,0,12"/>
      <Button Content="  ◫   Import Plugin ZIP" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#C4CAD5" Click="ImportPackage_Click"/>
      <Button Content="  ▤   Import Source Folder" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#C4CAD5" Margin="0,0,0,5" Click="ImportFolder_Click"/>
      <Button Content="  ▣   Package Contents" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#C4CAD5" Margin="0,0,0,5" Click="Packages_Click"/>
     </StackPanel>
     <StackPanel DockPanel.Dock="Bottom" Margin="8,0,8,10">
      <TextBlock Text="LYRA STUDIO" Foreground="#788195" FontSize="10" FontWeight="Bold"/>
      <TextBlock Text="Local workspace · 0.5.0 preview" Foreground="#9AA3B3" FontSize="11" Margin="0,5,0,0"/>
     </StackPanel>
    </DockPanel>
   </Border>
   <Grid Grid.Column="1" Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="2,0,2,16">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel>
      <TextBlock x:Name="PageTitle" Text="Widget Library" FontSize="22" FontWeight="Bold" Foreground="#202432"/>
      <TextBlock x:Name="PageSubtitle" Text="Local workspace · No WordPress server or internet connection required" Foreground="#8992A3" Margin="0,5,0,0"/>
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
      <Button Content="Desktop" Tag="desktop" Click="PreviewDevice_Click" Margin="0,0,5,0" Background="#252B39"/>
      <Button Content="Tablet" Tag="tablet" Click="PreviewDevice_Click" Margin="0,0,5,0" Background="#252B39"/>
      <Button Content="Mobile" Tag="mobile" Click="PreviewDevice_Click" Margin="0,0,10,0" Background="#252B39"/>
      <Button Content="Refresh" Background="#252B39" Click="Refresh_Click"/>
     </StackPanel>
    </Grid>
    <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="12" BorderBrush="#E6E9EF" BorderThickness="1">
     <Grid>
      <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430">
       <Border Width="66" Height="66" CornerRadius="18" Background="#F0EEFF" HorizontalAlignment="Center" Margin="0,0,0,18">
        <TextBlock Text="⌘" FontSize="32" Foreground="#7567E8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       </Border>
       <TextBlock x:Name="EmptyTitle" Text="Your local design workspace is ready" FontSize="19" FontWeight="Bold" Foreground="#252B39" HorizontalAlignment="Center"/>
       <TextBlock x:Name="EmptyDescription" Text="Import a plugin ZIP, source folder, or provider manifest. Browse its local package inventory and inspect supported widgets and recipes." TextWrapping="Wrap" TextAlignment="Center" Foreground="#8992A3" Margin="0,10,0,20" LineHeight="22"/>
       <Button Content="Import plugin ZIP or provider JSON" Click="ImportPackage_Click"/>
      </StackPanel>
      <Grid x:Name="CatalogState" Visibility="Collapsed">
       <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border Grid.Column="0" Background="#FBFCFD" BorderBrush="#E8EAF0" BorderThickness="0,0,1,0">
        <Grid Margin="12">
         <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
         <TextBlock x:Name="CatalogListTitle" Text="WIDGETS" FontSize="10" FontWeight="Bold" Foreground="#8992A3" Margin="4,4,4,12"/>
         <ListBox x:Name="WidgetList" Grid.Row="1" DisplayMemberPath="Name" BorderThickness="0" Background="Transparent" SelectionChanged="WidgetList_SelectionChanged"/>
         <ListBox x:Name="RecipeList" Grid.Row="1" DisplayMemberPath="Name" BorderThickness="0" Background="Transparent" Visibility="Collapsed" SelectionChanged="RecipeList_SelectionChanged"/>
         <ListBox x:Name="PackageFilesList" Grid.Row="1" DisplayMemberPath="DisplayName" BorderThickness="0" Background="Transparent" Visibility="Collapsed" SelectionChanged="PackageFilesList_SelectionChanged"/>
        </Grid>
       </Border>
       <Grid Grid.Column="1" Margin="18">
        <ScrollViewer x:Name="PreviewScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Visibility="Collapsed">
         <wv2:WebView2 x:Name="PreviewBrowser" Width="1280" Height="720" HorizontalAlignment="Left"/>
        </ScrollViewer>
        <StackPanel x:Name="SelectionInfo" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440" Visibility="Collapsed">
         <Border Width="54" Height="54" CornerRadius="15" Background="#F0EEFF" HorizontalAlignment="Center" Margin="0,0,0,16">
          <TextBlock Text="◈" FontSize="26" Foreground="#7567E8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
         </Border>
         <TextBlock x:Name="PreviewTitle" Text="Select an item" FontSize="20" FontWeight="Bold" Foreground="#252B39" HorizontalAlignment="Center"/>
         <TextBlock x:Name="PreviewSubtitle" Text="" Foreground="#8992A3" HorizontalAlignment="Center" Margin="0,7,0,12"/>
         <Border Background="#F7F8FA" CornerRadius="8" Padding="14">
          <TextBlock x:Name="PreviewMessage" Text="Choose an item to inspect its settings and local preview." Foreground="#697386" TextWrapping="Wrap" TextAlignment="Center" LineHeight="20"/>
         </Border>
        </StackPanel>
       </Grid>
      </Grid>
     </Grid>
    </Border>
   </Grid>
   <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E8EAF0" BorderThickness="1,0,0,0">
    <Grid Margin="18">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock Text="INSPECTOR" FontSize="10" FontWeight="Bold" Foreground="#8992A3" Margin="0,5,0,18"/>
     <StackPanel x:Name="InspectorEmptyState" Grid.Row="1" VerticalAlignment="Top">
      <TextBlock Text="Nothing selected" FontSize="16" FontWeight="Bold" Foreground="#252B39"/>
      <TextBlock Text="Import a provider manifest and select a widget. Its controls will be generated from the metadata supplied by that provider." TextWrapping="Wrap" Foreground="#8992A3" Margin="0,8,0,0" LineHeight="21"/>
      <Border Background="#F7F8FA" CornerRadius="8" Padding="12" Margin="0,22,0,0">
       <StackPanel>
        <TextBlock Text="SCHEMA-DRIVEN CONTROLS" FontSize="9" FontWeight="Bold" Foreground="#7567E8" Margin="0,0,0,8"/>
        <TextBlock Text="Text · Number · Toggle · Select · Color · Link · Media · Repeater · Group · Responsive" TextWrapping="Wrap" Foreground="#667085" FontSize="11" LineHeight="18"/>
       </StackPanel>
      </Border>
     </StackPanel>
     <Grid x:Name="WidgetInspector" Grid.Row="1" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock x:Name="InspectorTitle" Text="" FontSize="16" FontWeight="Bold" Foreground="#252B39" TextWrapping="Wrap"/>
      <TextBlock x:Name="InspectorDescription" Grid.Row="1" Text="" FontSize="10" Foreground="#8992A3" TextWrapping="Wrap" Margin="0,6,0,14"/>
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
       <StackPanel x:Name="InspectorFields"/>
      </ScrollViewer>
      <Expander Grid.Row="3" Header="Settings JSON" Margin="0,10,0,0">
       <StackPanel>
        <TextBox x:Name="SettingsJsonText" Height="118" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="10"/>
        <Button Content="Copy JSON" HorizontalAlignment="Right" Margin="0,8,0,0" Click="CopySettings_Click"/>
       </StackPanel>
      </Expander>
     </Grid>
     <StackPanel x:Name="RecipeInspector" Grid.Row="1" Visibility="Collapsed">
      <TextBlock x:Name="RecipeInspectorTitle" Text="" FontSize="16" FontWeight="Bold" Foreground="#252B39" TextWrapping="Wrap"/>
      <TextBlock x:Name="RecipeInspectorDescription" Text="" Foreground="#8992A3" TextWrapping="Wrap" Margin="0,8,0,12"/>
      <TextBlock x:Name="RecipeInspectorFormat" Text="" Foreground="#667085" FontSize="11"/>
      <TextBlock Text="Recipe structure editing and local project persistence are scheduled for upcoming releases." Foreground="#8992A3" TextWrapping="Wrap" Margin="0,16,0,0" FontSize="11"/>
     </StackPanel>
    </Grid>
   </Border>
  </Grid>
  <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E8EAF0" BorderThickness="0,1,0,0">
   <Grid Margin="14,0">
    <TextBlock x:Name="StatusText" Text="Ready · No provider manifest loaded" Foreground="#8992A3" FontSize="10" VerticalAlignment="Center"/>
    <TextBlock Text="Offline desktop · Windows" Foreground="#8992A3" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
   </Grid>
  </Border>
 </Grid>
</Window>
